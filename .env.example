# Supabase REST access. Use local values during development and the Cloud
# project URL/publishable key in Vercel.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Browser-safe Kakao Maps JavaScript key.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=replace-with-kakao-javascript-key

# Keep true only for local fallback testing. Production must be false.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# Local Supabase Google provider configuration. In Cloud, store these in the
# Supabase Dashboard provider settings, not in Vercel.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret

# Kakao REST API key and Login Client Secret. Local Supabase reads these from
# the shell; the deployed Next.js Kakao OIDC exchange also needs them as
# server-only Vercel environment variables.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=replace-with-kakao-client-secret
